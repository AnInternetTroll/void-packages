build_style=gnu-configure
configure_args="--disable-java --disable-java-modules --disable-mqtt
 --disable-riemann --enable-all-modules --enable-ipv6 --enable-manpages
 --enable-spoof-source --enable-systemd --localstatedir=/var/lib/syslog-ng
 --datadir=/usr/share --libexecdir=/usr/lib --sysconfdir=/etc/syslog-ng
 --with-jsonc=system --with-pidfile-dir=/run --with-python-packages=system"
conf_files="/etc/syslog-ng/syslog-ng.conf"
make_dirs="/var/lib/syslog-ng 0755 root root"
_depends="python3-boto3 python3-botocore python3-cachetools python3-certifi
 python3-charset-normalizer python3-google-auth python3-idna python3-kubernetes
 python3-oauthlib python3-pyasn1 python3-pyasn1-modules python3-dateutil
 python3-yaml python3-requests python3-requests-oauthlib python3-rsa python3-six
 python3-urllib3 python3-websocket-client python3-ply python3-tornado"
hostmakedepends="automake pkg-config which tar protobuf python3-setuptools ${_depends}"
makedepends="libfl-devel json-c-devel glib-devel pcre-devel libcurl-devel
 libnet-devel libesmtp-devel net-snmp-devel libdbi-devel libmaxminddb-devel
 protobuf-devel mongo-c-driver-devel libbson-devel grpc-devel hiredis-devel
 rabbitmq-c-devel librdkafka-devel python3-devel"
depends="${_depends}"
short_desc="Enhanced log daemon, supporting a wide range of input and output methods"
