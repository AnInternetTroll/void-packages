# Template file for 'hyprutils'
pkgname=hyprutils
version=0.2.1
revision=1
build_style=cmake
hostmakedepends="pkg-config"
makedepends="pixman-devel"
short_desc="Hyprland utilities library used across the ecosystem"
maintainer="Luca Matei Pintilie <luca@lucamatei.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprutils"
changelog="https://github.com/hyprwm/hyprutils/releases/"
distfiles="https://github.com/hyprwm/hyprutils/archive/refs/tags/v${version}.tar.gz"
checksum=061449c828d0cdaf7b147d9e232282fd0dde997c6ec7c43d51fe96d878b66c12

post_install() {
	vlicense LICENSE
}

hyprutils-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
